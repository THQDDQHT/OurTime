# 数据库配置
# 使用 Docker 容器名称连接数据库（推荐）
# 例如：postgresql-postgresqlService-1 或使用容器 ID
DB_HOST=postgresql-postgresqlService-1
DB_PORT=5432
DB_NAME=neural_db
DB_USER=neural_user
DB_PASS=your_secure_password_here

# JWT 配置（请修改为随机字符串）
JWT_SECRET=your_jwt_secret_key_at_least_32_characters_long_here
AUTH_SECRET=your_auth_secret_key_here

# 管理员密码
ROOT_PASSWORD=your_root_password_here

